[Unit]
Description=Notes Web Application
After=network.target

[Service]
User=notesapp
Group=notesapp
WorkingDirectory=/opt/notesapp
EnvironmentFile=/opt/notesapp/.env
ExecStart=/opt/notesapp/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target